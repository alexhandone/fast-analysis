# Copie este arquivo para .env e preencha somente os valores locais.
# Nunca versione o arquivo .env.
SQLSERVER_URL=mssql+pyodbc://USUARIO:SENHA@SERVIDOR/BANCO?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
FA_SOURCE_NAME=operacao
FA_QUERY_FILE=sql/sqlserver/operacao.sql
# Exemplo: FA_PRIMARY_KEY=id_pedido
FA_PRIMARY_KEY=
FA_DUCKDB_PATH=data/fast_analysis.duckdb
